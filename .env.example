# Required before this server is reachable by anyone but you.
TOKENFORGE_AUTH_TOKEN=

# HMAC secret for expiring download links. Generated and stored in .data/secret when unset.
TOKENFORGE_SECRET=

# Set to 1 when a trusted reverse proxy overwrites X-Forwarded-For.
TOKENFORGE_TRUST_PROXY=

# Optional overrides.
TOKENFORGE_DATA_DIR=.data
TOKENFORGE_MAX_ASSET_BYTES=26214400
TOKENFORGE_MAX_TOTAL_BYTES=167772160
